
# Finance Tracker - Environment Configuration

# Application Environment
NODE_ENV=production

# Database Configuration
MONGODB_URI=mongodb://admin:admin123@mongodb:27017/finance_tracker?authSource=admin

# Security Configuration
JWT_SECRET=your-secure-jwt-secret-key-change-this

# Server Configuration
PORT=3000

# Important Notes:
# 1. Change JWT_SECRET to a random secure string
# 2. In production, consider changing MongoDB credentials
# 3. This file should be copied to .env and configured
